PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/hospital_db
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=use_a_different_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d
FIELD_ENCRYPTION_KEY=base64_encoded_32_byte_key
SEARCH_HASH_KEY=independent_random_secret
CORS_ORIGIN=https://yourdomain.com
PUBLIC_APP_URL=https://yourdomain.com
EMAIL_PROVIDER=resend
EMAIL_FROM="HMS Security <security@yourdomain.com>"
RESEND_API_KEY=replace_with_provider_api_key
# Required only for the first platform-owner bootstrap; remove it after login/password rotation.
SUPER_ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_unique_12_plus_character_secret
# Development/test only. This flag is ignored in production.
ENABLE_TEST_DATA_SEED=false
EXPOSE_DEV_AUTH_TOKENS=false
