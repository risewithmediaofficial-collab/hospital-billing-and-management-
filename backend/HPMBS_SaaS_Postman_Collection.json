              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@citygeneral.com\",\n  \"password\": \"0000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
