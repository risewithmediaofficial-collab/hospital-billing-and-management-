            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Postman Specialist\",\n  \"email\": \"{{unique_staff_email}}\",\n  \"phone\": \"{{unique_staff_phone}}\",\n  \"password\": \"Doctor123!\",\n  \"role\": \"DOCTOR\",\n  \"specialization\": \"General Medicine\",\n  \"departmentId\": \"General Medicine\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/staff",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "staff"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.variables.set('unique_staff_email', 'doc.' + ts + '@citygeneral.com');",
                  "pm.variables.set('unique_staff_phone', '+1555' + String(ts).slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Staff Account Handled (200/201)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]); });"
                ]
              }
            }
          ]
        },
