# ==============================================================================
# HPMBS DOCKER DEPLOYMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for Main vs Test environments.

# ------------------------------------------------------------------------------
# 1. Deployment Environment Identifier
# ------------------------------------------------------------------------------
# Set project name so Main and Test containers do not conflict on the same host:
# For Main deployment:  COMPOSE_PROJECT_NAME=hpmbs_main
# For Test deployment:  COMPOSE_PROJECT_NAME=hpmbs_test
COMPOSE_PROJECT_NAME=hpmbs

# ------------------------------------------------------------------------------
# 2. Port Bindings
# ------------------------------------------------------------------------------
# Main repo defaults:
# FRONTEND_PORT=86
# BACKEND_PORT=5003
# MONGO_PORT=27021
#
# Test repo defaults (if running on same server):
# FRONTEND_PORT=89
# BACKEND_PORT=5004
# MONGO_PORT=27022
FRONTEND_PORT=86
BACKEND_PORT=5003
MONGO_PORT=27021

# ------------------------------------------------------------------------------
# 3. Application & Database Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
MONGO_INITDB_DATABASE=hpmbs_db
MONGO_URI=mongodb://mongo:27017/hpmbs_db
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. Security Keys & Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=hpmbs_super_secure_jwt_secret_key_2026_x89
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=hpmbs_super_secure_refresh_secret_key_2026_x89
REFRESH_TOKEN_EXPIRES_IN=30d
FIELD_ENCRYPTION_KEY=aHBtYnNfYWVzMjU2X2VuY3J5cHRpb25fa2V5XzMyYiE=
SEARCH_HASH_KEY=hpmbs_search_hash_secret_key_2026_production_safe_key_32b
